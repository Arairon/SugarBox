{
  "manifest_version": 3,
  "name": "SugarBox - SugarCube Save Manager",
  "version": "0.1",
  "description": "Save manager for most SugarCube games. Supports cloud sync, but can be ran completely offline",
  "icons": {
    "48": "icons/48.png",
    "96": "icons/96.png",
    "128": "icons/128.png"
  },
  "permissions": [
    "storage",
    "unlimitedStorage",
    "activeTab",
    "scripting",
    "tabs"
  ],
  "action": {
    "default_popup": "src/popup/index.html"
  },
  "background": {
    "service_worker": "assets/background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "assets/content.js"
      ],
      "all_frames": true
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "assets/page.js",
        "assets/overlay.js"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ]
}
