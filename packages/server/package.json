{
  "name": "sugarbox-server",
  "version": "0.0.1",
  "description": "",
  "main": "index.js",
  "type": "module",
  "scripts": {
    "db:generate": "bunx --bun prisma generate",
    "db:apply": "bunx --bun prisma migrate dev",
    "db:migrate": "bunx --bun prisma migrate deploy",
    "db:push": "bunx --bun prisma db push",
    "db:studio": "bunx --bun prisma studio",
    "build": "bun build src/index.ts --target bun --outdir ./dist",
    "dev": "bun --watch run src/index.ts",
    "prod": "bunx --bun prisma migrate deploy && bun dist/index.js",
    "format": "bunx --bun prettier --write \"**/*.{ts,tsx,js,jsx,mdx}\" --cache",
    "build:container": "docker build -t ghcr.io/arairon/sugarbox ."
  },
  "keywords": [],
  "author": "arairon",
  "license": "GPL-3.0-only",
  "dependencies": {
    "@prisma/client": "6.6.0",
    "@types/yamljs": "^0.2.34",
    "argon2": "^0.41.1",
    "body-parser": "^1.20.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "jsonwebtoken": "^9.0.2",
    "jwt": "^0.2.0",
    "morgan": "^1.10.0",
    "ms": "^2.1.3",
    "nodemon": "^3.1.9",
    "winston": "^3.17.0",
    "yamljs": "^0.3.0",
    "zod": "^3.24.2",
    "zod_utilz": "^0.8.3"
  },
  "devDependencies": {
    "@better-auth/cli": "^1.2.5",
    "@eslint/js": "^9.24.0",
    "@types/body-parser": "^1.19.5",
    "@types/cookie-parser": "^1.4.8",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/morgan": "^1.9.9",
    "@types/ms": "^2.1.0",
    "@types/node": "^22.10.5",
    "@types/swagger-jsdoc": "^6.0.4",
    "@types/swagger-ui-express": "^4.1.7",
    "eslint": "^9.24.0",
    "globals": "^16.0.0",
    "prisma": "^6.19.2",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.29.0"
  }
}
